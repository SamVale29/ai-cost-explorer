{
  "name": "ai-cost-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "Compare LLM pricing, context windows, capabilities and observed performance with transparent data sources.",
  "author": "Sam Vale",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm data:build && vite build && pnpm postbuild",
    "postbuild": "node scripts/copy-spa-fallback.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "data:validate": "tsx scripts/validate-data.ts",
    "data:build": "tsx scripts/build-catalog.ts",
    "data:health": "tsx scripts/catalog-health.ts",
    "data:check-sources": "tsx scripts/check-sources.ts",
    "data:diff": "tsx scripts/create-snapshot.ts --diff",
    "data:snapshot": "tsx scripts/create-snapshot.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "generate:og": "tsx scripts/generate-og-image.ts",
    "generate:screenshots": "tsx scripts/capture-screenshots.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:check-empty": "tsx scripts/benchmark-contract.ts",
    "pricing:watch": "tsx scripts/pricing-watch.ts"
  },
  "dependencies": {
    "decimal.js": "^10.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "jsdom": "^30.0.1",
    "playwright": "^1.50.1",
    "prettier": "3.9.6",
    "sharp": "^0.35.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
